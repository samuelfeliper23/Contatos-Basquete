<!DOCTYPE html>
<html lang="pt-br">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= titulo %></title>
  <link rel="stylesheet" href="/style.css">
</head>
<body>

  <div class="container">

    <header>
      <h1>✏️ <%= titulo %></h1>
      <!-- contato.nome foi enviado pelo server.js como variável EJS -->
      <p class="subtitulo">Editando: <strong><%= contato.nome %></strong></p>
    </header>

    <!--
      FORMULÁRIO DE EDIÇÃO
      O action usa o ID do contato para saber qual registro atualizar.
      Os campos já vêm preenchidos com os dados atuais (atributo value).
    -->
    <form action="/contatos/editar/<%= contato.id %>" method="POST" class="formulario">

      <div class="campo">
        <label for="nome">Nome completo:</label>
        <!--
          value="..." → preenche o campo com o valor atual
          Assim o usuário não precisa redigitar tudo, só corrige o que mudar
        -->
        <input
          type="text"
          id="nome"
          name="nome"
          value="<%= contato.nome %>"
          required>
      </div>

      <div class="campo">
        <label for="email">E-mail:</label>
        <input
          type="email"
          id="email"
          name="email"
          value="<%= contato.email %>"
          required>
      </div>

      <div class="campo">
        <label for="data_nasc">Data de Nascimento:</label>
        <input
          type="date"
          id="data_nasc"
          name="data_nasc"
          value="<%= contato.data_nasc %>"
          required>
      </div>

      <div class="campo">
        <label for="modalidade">Modalidade:</label>
        <input
          type="text"
          id="modalidade"
          name="modalidade"
          value="<%= contato.modalidade %>"
          required>
      </div>

      <div class="botoes">
        <button type="submit" class="btn btn-azul">Salvar Alterações</button>
        <!-- Cancelar: volta para a lista sem alterar nada -->
        <a href="/" class="btn btn-cinza">Cancelar</a>
      </div>

    </form>

  </div>

</body>
</html>
