<!DOCTYPE html>
<html lang="pt-br">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= titulo %></title>
  <link rel="stylesheet" href="/style.css">
</head>
<body>

  <div class="container">

    <header>
      <h1>➕ <%= titulo %></h1>
      <p class="subtitulo">Central de Contatos dos Jogadores</p>
    </header>

    <!--
      FORMULÁRIO DE CRIAÇÃO
      action="/contatos" → envia para a rota POST /contatos no server.js
      method="POST"     → usa o método HTTP POST
    -->
    <form action="/contatos" method="POST" class="formulario">

      <div class="campo">
        <label for="nome">Nome completo:</label>
        <!--
          name="nome" → o Express lê isso como req.body.nome
          required    → o navegador impede o envio se o campo estiver vazio
        -->
        <input
          type="text"
          id="nome"
          name="nome"
          placeholder="Ex: João da Silva"
          required>
      </div>

      <div class="campo">
        <label for="email">E-mail:</label>
        <!-- type="email" → o navegador valida o formato automaticamente -->
        <input
          type="email"
          id="email"
          name="email"
          placeholder="Ex: joao@email.com"
          required>
      </div>

      <div class="campo">
        <label for="data_nasc">Data de Nascimento:</label>
        <input
          type="date"
          id="data_nasc"
          name="data_nasc"
          placeholder="Ex: 30/09/2003"
          required>
      </div>

      <div class="campo">
        <label for="modalidade">Modalidade:</label>
        <input
          type="text"
          id="modalidade"
          name="modalidade"
          placeholder="Ex: Basquete"
          required>
      </div>

      <div class="botoes">
        <!-- type="submit" → envia o formulário ao clicar -->
        <button type="submit" class="btn btn-verde">Salvar Contato</button>
        <!-- Link de cancelar: volta para a lista sem salvar -->
        <a href="/" class="btn btn-cinza">Cancelar</a>
      </div>

    </form>

  </div>

</body>
</html>
